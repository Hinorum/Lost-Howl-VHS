BOT_TOKEN=
ADMIN_IDS=

# Час закрытия голосования (UTC): сразу после него — мгновенный подсчёт,
# итоги, выплаты и запуск следующего дня (без часа простоя).
DAY_CLOSE_HOUR_UTC=11

DATABASE_URL=sqlite+aiosqlite:///./data/the_way.db
# Прод — managed Postgres, напр. Supabase (session pooler, порт 5432):
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Neon/Render-URL с ?sslmode=... тоже поддержаны (ключ снимается для asyncpg).
# Путь к PEM-файлу корневого CA для Postgres (нужен Supabase: сертификаты
# pooler подписаны внутренним Root CA, а не публичным). Для *.pooler.supabase.com
# сертификат репозитория (certs/supabase-root.pem) подхватывается сам, даже если
# DATABASE_CA пуст; локальный Postgres (localhost) — без SSL.
DATABASE_CA=
TIMEZONE=Europe/Moscow
MEDIA_DIR=./media/generated

# === Схема базы ===
# Осиротевшие NOT NULL-колонки удалённых механик (без DEFAULT) ломали INSERT
# новых дней. Раньше init_db дропал их на каждом старте автоматически (рискованно
# при откате или канареечном деплое). Теперь дроп — разовая операция: включи true
# на один деплой после удаления колонки из моделей, затем верни в false.
# false (по умолчанию) — колонки не трогаем, найденные сироты только логируются.
DROP_ORPHAN_COLUMNS=false

# Ключи подключения к внешним API (настройки генераций перерабатываются).
# Текстовый «Ведущий» (D&D-стиль): любой OpenAI-совместимый провайдер.
# Бесплатный вариант — Hugging Face: создай токен на hf.co/settings/tokens.
#   LLM_API_KEY=hf_xxxxxxxxxxxx
#   LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
# Другие варианты: Groq (https://api.groq.com/openai/v1/chat/completions),
# локальная Ollama, OpenRouter (https://openrouter.ai/api/v1/chat/completions).
LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
# Генерация кадров (Google Gemini Image): ключ aistudio.google.com -> Get API key.
GEMINI_API_KEY=

# Render выставит PORT и RENDER_EXTERNAL_URL сам. Локально оставь пустым — будет polling.
WEBHOOK_BASE_URL=
# Само-пинг /health раз в N секунд: держит free plan Render от засыпания,
# чтобы день открывался по UTC-сетке. 0 — выключить.
SELF_PING_SECONDS=600

# Секрет для проверки запросов к /webhook (любая случайная строка). Пусто — без проверки.
WEBHOOK_SECRET=

# === Личные приглашения (?start=ref_<id>_<токен>) ===
# Секрет подписывает токен реферальной ссылки: без него нельзя вписать чужой id.
# Пусто — рефералки выключены, /invite отвечает «не открыты».
REFERRAL_SECRET=
# Username бота без «@» для ссылки t.me/<username>?start=... . Пусто — бот сам
# запросит get_me при первом /invite и закэширует.
BOT_USERNAME=

# === TON-ставки (пока каркас, выключено) ===
# Включать только когда всё готово: казначейский кошелёк, watcher, выплаты.
TON_ENABLED=false
# Контур: mainnet или testnet. Testnet — отдельный «второй контур» для проверки:
# свой казначейский кошелёк, свои лимиты API, ставки помечаются сетью и не смешиваются.
TON_NETWORK=mainnet
# Адрес казначейского кошелька (сюда приходят ставки).
TREASURY_ADDRESS=
# Мнемоника казначея (24 слова). Только в секретах Render! Нужна для выплат победителям.
TREASURY_MNEMONIC=
# То же для тестнет-контура (кошелёк из https://t.me/testgiver_ton_bot).
TREASURY_TESTNET_ADDRESS=
TREASURY_TESTNET_MNEMONIC=
# Сквозной прогон контура на живом тестнете (scripts/e2e_testnet.py). Ниже —
# ключи игрока, с чьего кошелька e2e делает реальную ставку; запись игрока
# должна существовать в players c привязанным и верифицированным кошельком.
E2E_PLAYER_ID=
E2E_PLAYER_MNEMONIC=
# E2E_TESTNET=1 включает живой pytest-тест (маркер e2e): без флага он скапывается.
E2E_TESTNET=0
# Сколько секунд ждать подтверждения ставки в фазе stake (по умолчанию 180).
E2E_STAKE_TIMEOUT_SECONDS=180
# Версия контракта казначея: auto (детект по адресу), v4r2 или v5r1.
# Современные кошельки (Keeper и др.) созданы как v5r1.
TREASURY_WALLET_VERSION=auto
# Свежий JSON-конфиг лайтсерверов для исходящих переводов (pytoniq, ADNL/UDP).
# Встроенный конфиг тестнета периодически мёртв — выплаты встают с ошибкой
# «have no alive peers». Лечение: официальный тестнет-конфиг
LITESERVER_CONFIG_URL=https://ton.org/testnet-global.config.json
# TonAPI (tonapi.io) или toncenter. Ключ повышает лимиты запросов.
TON_API_BASE=https://tonapi.io
TON_API_BASE_TESTNET=https://testnet.tonapi.io
TON_API_KEY=
# Фолбэк-источник истории переводов (Toncenter API v3). Включается сам,
# когда TonAPI лжёт (404 истории при живом казначее) или лежит совсем.
# Ключ: https://t.me/toncenter_bot — повышает лимиты запросов.
TONCENTER_API_BASE=https://toncenter.com
TONCENTER_API_BASE_TESTNET=https://testnet.toncenter.com
TONCENTER_API_KEY=
# Лимиты ставки и распределение фонда дня, %:
# 96% — ставившим на верный путь пропорционально,
# PACK_FUND_PCT — Фонд Стаи (накопление, раздача вручную),
# WEEKLY_POT_PCT — копилка недели (в понедельник её делят топ-3 /top),
# OWNER_RAKE_PCT — хранителю игры, LEADERBOARD_RAKE_PCT — в копилку месяца (/top).
STAKE_MIN_TON=0.5
OWNER_RAKE_PCT=0.5
LEADERBOARD_RAKE_PCT=0.5
WEEKLY_POT_PCT=2
PACK_FUND_PCT=1
# Недельный лидерборд: минимум дней голосования за неделю для призового места
# (анти-мультиаккаунт) и доли мест 1-й/2-й/3-й в процентах: сильнейший больше.
WEEKLY_MIN_DAYS=4
WEEKLY_PRIZE_PCTS=50,30,20
# Куда уходят рейк и копилка месяца (владелец держит до выплаты лидерам месяца).
OWNER_WALLET_ADDRESS=
# Сколько секунд должно пройти после транзакции, чтобы ставка считалась подтверждённой.
STAKE_CONFIRM_SECONDS=40
# Частота цикла наблюдателя входящих (сек): каждый цикл = один запрос в
# индексор. 60 = подтверждение ставок в течение минуты; 120/180 — вдвое-
# втрое дешевле по квоте запросов провайдера (если лимиты жмут).
TON_WATCH_INTERVAL_SECONDS=60
# Сколько раз зависшая выплата ретраится, прежде чем окончательно встать в failed.
PAYOUT_MAX_ATTEMPTS=5
# Через сколько секунд после вещания выплата считается потерянной, если memo так и
# не появилось в блокчейне: метка bcast: значит лишь «лайтсервер принял запрос»,
# а не «транзакция в блоке». Дольше этого окна строка возвращается в очередь.
PAYOUT_CONFIRM_TIMEOUT_SECONDS=1200
# === Комиссии и пороги выплат (значения — draft, см. docs/MAINNET_READINESS.md) ===
# PAYOUT_FEE_GRAM: ОЦЕНКА комиссии сети за один исходящий перевод. Вычитается
# из призового пула заранее и пропорционально доле каждого победителя, поэтому
# приз приходит «чистыми», а казначей не финансирует газ из своего остатка.
# В цепочке платит настоящий total_fees + fwd_fee — оценка должна быть чуть выше
# реальной: недобор встаёт очередью («казначей подкачан») и ломает сверку БД↔цепочка,
# а перебор тихо срезает каждого победителя дня. Замер: 5–10 холостых переводов
# A→B с memo, среднее × 1.15, округлить вверх. Ставить 0.002 до замера нельзя
# вслепую: на testnet замер даёт ~0.0006 Gram на перевод.
PAYOUT_FEE_GRAM=0.002
# MIN_PAYOUT_GRAM: перевод меньше этой суммы не создаётся вовсе — комиссия съела бы
# большую его часть. Доли-пыль капают в копилку недели (видно в итогах, деньги не теряются).
# Ориентир — 10 × PAYOUT_FEE_GRAM, чтобы газ не превышал ~10% приза.
MIN_PAYOUT_GRAM=0.02
# REFUND_MIN_GRAM: переводы дешевле этой суммы (мусор/спам) авто-возврата не создают —
# газ возврата дороже самой пыли, такие строки стали бы убыточными dead-letter выплатами.
REFUND_MIN_GRAM=0.05
# REFUND_FEE_RATIO: 0 = с каждого возврата ставки удерживается плоская PAYOUT_FEE_GRAM.
# Значение > 0 (напр. 0.01 = 1%) делает комиссию пропорциональной ставке: возврат = ставка × (1 − доля).
# Нужно, только если плоскую оценку пришлось сильно завысить, иначе сбор с крупных
# ставок станет несправедливо большим. По умолчанию 0 — не трогать без замеров.
REFUND_FEE_RATIO=0
# Глубина скана входящих переводов казначея за цикл наблюдателя (раз в минуту):
# до WATCH_MAX_PAGES страниц по WATCH_PAGE_LIMIT транзакций. Курсор в БД делает
# покрытие кумулятивным — после простоя хвост догоняется за пару циклов.
WATCH_PAGE_LIMIT=100
WATCH_MAX_PAGES=50
# === Зеркало казны (сверка «в ноль») ===
# Независимая копия истории казначейского кошелька: баланс = Σ balance_delta
# транзакций от генезиса до головы, поэтому тождество сверяется с живым
# балансом БЕЗ допуска на газ (реальная комиссия — из цепочки). /treasury
# показывает результат; /mirror reset confirm пересобирает при рассинхроне.
# Частота цикла синка (сек) и объём одного цикла (страниц по 100 транзакций):
# бутстрап глубокой истории занимает несколько циклов — оба значения флексиб.
TREASURY_MIRROR_INTERVAL_SECONDS=180
TREASURY_MIRROR_MAX_PAGES_PER_SYNC=40
# Личные дубликаты рассылок в личку подписанным игрокам: итоги дня, новый день
# и прочие анонсы. Игрок управляет подпиской кнопкой в /start.
PLAYER_DM=true
# Мир игры: название попадает в тексты бота. Поменяв его, получишь другой мир
# с той же механикой.
WORLD_NAME=Эхо Стаи

# === Платная смена выбора ===
# 23 часа на раздумья; передумать — платно: Telegram Stars или TON с memo rv:<день>.
REVOTE_ENABLED=true
REVOTE_STARS=25
REVOTE_TON=0.1

# === Реферальные награды ===
# Доля (%) от ПОДТВЕРЖДЁННОЙ ставки игрока, пришедшего по личной ссылке, которая
# капает в копилку пригласившего и НЕ попадает в пул победителей. 1.0 = при всех
# приведённых ставках фонд дня 95% победителям + 1% реферальной награде (день без
# приведённых ставок делится как раньше — 96% победителям).
REFERRAL_PCT=1.0
# Порог (Gram), с которого накопленная реферальная награда превращается в перевод;
# ниже — копится дальше. При PAYOUT_FEE_GRAM=0.002 газ — 0.4% выплаты, порог
# оставляем как есть; см. обоснование в docs/MAINNET_READINESS.md.
REFERRAL_MIN_PAYOUT_GRAM=0.5

# === Health / мониторинг ===
# HEALTH_TOKEN: задан — снимок /health (очередь выплат, возраст тика, watcher)
# доступен только с авторизацией (Authorization: Bearer <token> или ?token=).
HEALTH_TOKEN=
# HEALTH_REQUIRE_TOKEN=true полностью закрывает /health БЕЗ токена. Осторожно:
# дефолтный чек жизни Render токен не передаёт и счёл бы процесс мёртвым.
# Включение при пустом HEALTH_TOKEN — конфиг-ошибка: бот не стартует (fail-fast).
HEALTH_REQUIRE_TOKEN=false